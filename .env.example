# Database
DATABASE_URL=postgresql://dental_user:dental_pass@localhost:5432/dental_clinic

# App
APP_URL=http://localhost:3000

# Session (must be at least 32 characters)
SESSION_SECRET=change-this-to-a-random-32-char-secret-at-minimum

# Encryption key for YCloud API keys stored in DB
ENCRYPTION_KEY=change-this-to-another-random-key

# YCloud integration
YCLOUD_API_KEY=your-ycloud-api-key-here
YCLOUD_BUSINESS_PHONE=+996XXXXXXXXX
YCLOUD_INBOUND_SECRET=your-strong-random-secret-for-data-connector
YCLOUD_WEBHOOK_SECRET=your-strong-random-webhook-secret

# Clinic info
CLINIC_NAME=Dental Clinic
CLINIC_ADDRESS="Бишкек, ул. Токомбаева 7/5, Асанбай"
CLINIC_TIMEZONE=Asia/Bishkek
